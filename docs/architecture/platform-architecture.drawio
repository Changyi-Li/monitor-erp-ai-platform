        </mxCell>
        <mxCell id="v_p2_erp" value="Monitor ERP API 集成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="c6">
          <mxGeometry x="20" y="30" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v_p2_video" value="视频生成（操作手册 → 视频）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="c6">
          <mxGeometry x="340" y="30" width="280" height="60" as="geometry" />
