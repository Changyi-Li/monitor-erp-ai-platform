        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="v_customer" target="v_gateway"><mxGeometry relative="1" as="geometry" /></mxCell>
