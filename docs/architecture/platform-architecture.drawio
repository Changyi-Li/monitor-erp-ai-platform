        <mxCell id="v_p2_gantt" value="甘特图 / 邮箱同步" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="c6">
          <mxGeometry x="20" y="100" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v_p2_cust_agent" value="客户 AI Agent（复用范围注入）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="c6">
          <mxGeometry x="340" y="100" width="280" height="60" as="geometry" />
