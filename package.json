{
  "name": "monitor-erp-ai-platform",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @monitor/api db:generate",
    "db:migrate": "pnpm --filter @monitor/api db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.10.8",
    "typescript": "^5.9.0"
  }
}
