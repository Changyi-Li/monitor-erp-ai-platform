# 测试环境示例：复制为 .env.test 并填入真实值（e2e 指向 monitor_erp_test，勿碰开发库）
# 注意：正式 .env.test 的 DATABASE_URL 为受限角色 app_tenant_user（见 setup-test-db.ts）
DATABASE_URL=postgres://app_tenant_user:<password>@localhost:5432/monitor_erp_test
DATABASE_OWNER_URL=postgres://postgres:<password>@localhost:5432/monitor_erp_test
JWT_SECRET=test-secret-0123456789abcdef0123456789abcdef0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
WEB_URL=http://localhost:3000
