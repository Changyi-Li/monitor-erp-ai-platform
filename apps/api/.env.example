# 开发环境示例：复制为 .env 并填入真实值（密码需 URL 编码，如 ! → %21）
# 应用连接必须是受限角色 app_tenant_user（非 owner、无 BYPASSRLS），RLS 兜底生效。
# 先以 owner 跑迁移，再执行：ALTER ROLE "app_tenant_user" WITH LOGIN PASSWORD '<强口令>';
DATABASE_URL=postgres://app_tenant_user:<password>@localhost:5432/monitor_erp
# owner 连接：仅迁移/管理/seed 用（生产不配置）；迁移需以它运行（CREATE ROLE/GRANT/ALTER DEFAULT PRIVILEGES）
DATABASE_OWNER_URL=postgres://postgres:<password>@localhost:5432/monitor_erp
JWT_SECRET=<node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))">
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PORT=3001
# 邀请链接前缀（web 前端地址；无邮件基础设施时 API 直接返回完整链接给创建者）
WEB_URL=http://localhost:3000
# 适配层驱动：内存实现（测试/开发默认）；未来切 S3/RocketMQ 只改这里
STORAGE_DRIVER=memory
MQ_DRIVER=memory
INDEX_DRIVER=memory
LLM_DRIVER=memory
# LLM 场景路由（issue #24）：场景专属驱动优先，缺省回退 LLM_DRIVER；换模型只改这里，业务代码零改动
LLM_DRIVER_AGENT=memory
LLM_DRIVER_DOCUMENT_PARSING=memory
LLM_DRIVER_MANUAL_GENERATION=memory
LLM_DRIVER_EMBEDDING=memory
# openai-compatible 驱动（Qwen-VL/DashScope/DeepSeek/GLM）：某场景配 openai 必须给 API_KEY（否则启动失败）
# LLM_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_OPENAI_API_KEY=
# LLM_OPENAI_MODEL=qwen-vl-max
